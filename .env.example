# VoxPrime Environment Configuration
# Copy this file to .env and fill in your values

# Server identity
SERVER_NAME=VoxPrime
DEBUG=false

# LLM Configuration (Qwen 3.5 via Ollama)
LLM_MODEL=qwen3.5:latest
LLM_BASE_URL=http://localhost:11434
# Optional: use a vision model only when you attach images/screenshots
# VOXPRIME_VISION_MODEL=qwen2.5vl:latest
OLLAMA_HOST=http://localhost:11434

# Tool settings
MAX_TOKENS=4096
TEMPERATURE=0.7

# STT - Faster Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# TTS - Kokoro
KOKORO_VOICE=default

# API Keys (optional - for web search, etc.)
# TAVILY_API_KEY=your_key_here

# MCP (optional git server via uvx; built-in file tools work without it)
# Max files auto-attached for scoped analysis (e.g. analyze the client); use read_file for the rest
# VOXPRIME_ANALYSIS_MAX_FILES=2

# Max seed files attached for fix/debug in a named folder (e.g. fix client folder)
# VOXPRIME_FIX_MAX_FILES=3

# Retries when model tool JSON is truncated or invalid (then whole-file fence fallback)
# VOXPRIME_TOOL_JSON_RECOVERY=4

# VOXPRIME_MCP_SKIP_GIT=1
# VOXPRIME_GIT_REPO=C:\path\to\your\git\repo
